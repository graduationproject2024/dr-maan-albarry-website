{
  "name": "dr-maan-albarry-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "playwright test",
    "test:evidence": "npm run build && node tests/measure.mjs docs/implementation/phase-0-phase-1/final-closure/evidence",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/release-check.mjs",
    "test:gate": "playwright test tests/content-registry.spec.js tests/section-registry.spec.js tests/phase0-content.spec.js tests/seo.spec.js tests/routing.spec.js tests/first-render.spec.js tests/hero-portrait.spec.js tests/phase1-pages.spec.js tests/phase1-mobile.spec.js tests/plates-clarity.spec.js tests/closure.spec.js tests/vision-optics.spec.js tests/cataract-constraints.spec.js tests/journeys/axe.spec.js tests/journeys/security.spec.js",
    "test:full": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "gh-pages": "^6.3.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.170.0"
  }
}
